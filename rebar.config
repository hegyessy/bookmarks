{erl_opts, [debug_info, warnings_as_errors]}.
{minimum_otp_vsn, "28"}.
{deps, [
    {zev, {git_subdir, "git@github.com:hegyessy/zev.git", {tag, "v0.4.0"}, "apps/zev"}},
    {zev_cli, {git_subdir, "git@github.com:hegyessy/zev.git", {tag, "v0.4.0"}, "apps/zev_cli"}},
    {zev_dev, {git_subdir, "git@github.com:hegyessy/zev.git", {tag, "v0.4.0"}, "apps/zev_dev"}}
]}.
{shell, [{apps, [bookmarks]}]}.
{eunit_opts, [verbose]}.
{relx, [
    {release, {bookmarks, "0.1.0"}, [sasl, bookmarks]},
    {vm_args, "config/vm.args"},
    {dev_mode, false},
    {include_erts, true},
    {include_src, false}
]}.
{profiles, [{prod, [{erl_opts, [no_debug_info]}]}]}.
